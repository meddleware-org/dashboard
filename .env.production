# Committed defaults for the dashboard production build (auto-loaded by `vite build`).
# These are public Sui addresses — not secrets — so they are safe to commit.
# Override at deploy time via Docker --build-arg or Cloudflare Pages environment variables
# (takes precedence over this file).
# Local dev: copy .env.example to .env.local and edit there (never commit .env.local).

# Token deployer fee treasury — required by @meddleware/token-deployer-sui when embedded.
# The dashboard's Vite instance resolves VITE_* for all embedded library source at bundle time.
VITE_FEE_TREASURY_TESTNET=0xe6b2810abfc5a6f37a375f73e3ba76cfc37584196e453255ad3c9ca2f0ede0ed
VITE_FEE_TREASURY_MAINNET=0xe6b2810abfc5a6f37a375f73e3ba76cfc37584196e453255ad3c9ca2f0ede0ed
