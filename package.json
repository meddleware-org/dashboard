{
  "name": "@meddleware/dashboard",
  "version": "0.1.85",
  "homepage": "https://docs.meddleware.co.uk/",
  "description": "Meddleware tools hub — Vue 3 SPA listing hosted services (Walrus, Access Gate) with white-label deploy options.",
  "author": "Meddleware <dev@meddleware.co.uk>",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meddleware-org/dashboard.git"
  },
  "type": "module",
  "files": [
    "src",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint:css": "stylelint \"src/**/*.{css,vue}\"",
    "lint:js": "eslint .",
    "lint": "npm run lint:css && npm run lint:js && npm run lint:html",
    "lint:html": "html-validate \"src/**/*.vue\"",
    "licenses": "node scripts/third-party-licenses.mjs",
    "check:licenses": "node scripts/third-party-licenses.mjs --check",
    "check:dist": "node scripts/check-inline-scripts.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@meddleware/access-gate-ui": "^0.1.37",
    "@meddleware/dao-ui": "^0.1.34",
    "@meddleware/design-tokens": "^0.1.10",
    "@meddleware/seal-ui": "^0.0.38",
    "@meddleware/token-deployer-ui": "^0.0.36",
    "@meddleware/treasury-ui": "^0.0.18",
    "@meddleware/ui": "^0.1.31",
    "@meddleware/wallet-adapter": "^0.0.17",
    "@meddleware/walrus-ui": "^0.1.58",
    "@mysten/sui": "^2.36.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@meddleware/eslint-config": "^0.0.3",
    "@playwright/test": "~1.64.1",
    "@types/node": "~24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.2",
    "html-validate": "^11.16.4",
    "html-validate-vue": "^9.3.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.30",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.0",
    "vite": "^8.3.4",
    "vitest": "~5.0.2",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "~3.3.13"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
